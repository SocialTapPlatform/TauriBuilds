{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "socialtap",
  "version": "4.5.0",
  "identifier": "social.socialtap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SocialTap",
        "width": 1000,
        "height": 700,
        "userAgent": "SocialTap Desktop Client v4.5.0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/128x128.ico",
      "icons/128x128_fixed.png"
    ]
  }
}